{
  "opencollection": "1.0.0",
  "info": {
    "name": "Tampa Electric Account Accounts Service Requests API",
    "version": "1.0.0"
  },
  "items": [
    {
      "info": {
        "name": "Service Requests",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Service Requests",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.tecoenergy.com/v1/accounts/:accountNumber/service-requests",
            "params": [
              {
                "name": "accountNumber",
                "value": "",
                "type": "path",
                "description": "Customer account number."
              },
              {
                "name": "status",
                "value": "",
                "type": "query",
                "description": "Filter by service request status."
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Retrieve open and historical service requests for a customer account."
        },
        {
          "info": {
            "name": "Create Service Request",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.tecoenergy.com/v1/accounts/:accountNumber/service-requests",
            "params": [
              {
                "name": "accountNumber",
                "value": "",
                "type": "path",
                "description": "Customer account number."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Submit a new service request for a customer account."
        }
      ]
    }
  ],
  "bundled": true
}